# Clave de API de Gemini (Inferencia multimodal para Nodos 1 al 6)
GOOGLE_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Puerto expuesto en la máquina host para el Nodo 0 (Evita conflicto con Laravel en :8000)
ORCHESTRATOR_HOST_PORT=8010

# Endpoint interno de Playwright MCP en la red de Docker
PLAYWRIGHT_MCP_URL=http://playwright-mcp:8931/mcp

# Dominios y hosts autorizados para ser auditados (Protección anti-SSRF)
ALLOWED_TARGET_HOSTS=host.docker.internal:8000,localhost:8000
